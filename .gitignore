# ==============================================================================
# REVVO — .gitignore
# ==============================================================================

# --- Prywatne dane, sekrety i środowisko -------------------------------------
.env
.env*
!.env.example
*.env
*.env.*
!*.env.example
web/.env
web/.env*
!web/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.credentials
credentials.json
token.json
secrets/

# --- Testy, raporty i artefakty testowe ---------------------------------------
test/
tests/
__tests__/
**/tests/
**/__tests__/
*.test.*
*.spec.*
*-test.*
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
.pytest_cache/
.coverage
htmlcov/
cypress/videos/
cypress/screenshots/

# --- Zależności ---------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build i frameworki (Next.js, Vercel) --------------------------------------
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Logi i pliki tymczasowe --------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.tmp
*.bak
scratch/

# --- System operacyjny i edytory ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Asystenci AI i pliki konfiguracyjne (Claude, Agents) ---------------------
.claude/
.claude*
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.gemini/
.system_generated/

# --- Bazy danych lokalne / zrzuty tymczasowe ----------------------------------
*.sqlite
*.sqlite3
*.db
*.local.sql

# --- Dane licencjonowane i materiały źródłowe (tylko lokalnie) ---------------
# Zrzut car2db: regulamin zabrania publikowania bazy
/baza-danych/
# Oryginały wideo (strona serwuje kopie z web/public/video)
/background/
# Zdjęcia źródłowe z Wikimedia Commons, atrybucje, prompty
/content/
# Design system generowany lokalnie
/design-system/
# Wyniki pośrednie skryptów importu (zawierają dane z katalogu car2db)
web/scripts/commons/generacje.json
web/scripts/wikidata/wikidata_picks.json
web/scripts/wikidata/raport.tsv
# Zrzuty baz, eksporty i surowe pliki graficzne
*.dump
*.sql.gz
*.csv
*.tsv
*.psd
*.ai
*.heic
*.mov
*.raw

# --- Duplikaty tworzone przez iCloud (Pulpit synchronizowany) ----------------
* 2
* 2.*
* 3
* 3.*
