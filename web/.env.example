# ─────────────────────────────────────────────────────────────
# REVVO — zmienne środowiskowe (szablon .env.example)
# Skopiuj ten plik do .env i uzupełnij własnymi wartościami:
# cp .env.example .env
# Zasada: NEXT_PUBLIC_* trafia do przeglądarki — NIGDY nie dawaj tam sekretów.
# ─────────────────────────────────────────────────────────────

# ── Aplikacja ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=REVVO

# ── Baza danych: PostgreSQL ──────────────────────────────────
# Lokalnie (Docker / natywny Postgres):
DATABASE_URL=postgresql://user:password@localhost:5432/revvo_db
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/revvo_db

# ── Autoryzacja / sesje ──────────────────────────────────────
# Wygeneruj losowy sekret min. 32 bajty: `openssl rand -base64 32`
AUTH_SECRET=twoj_losowy_sekret_min_32_bajty
AUTH_TRUST_HOST=true

# ── Cloudflare R2 (storage zdjęć i assetów) ──────────────────
R2_ACCOUNT_ID=twoj_cloudflare_account_id
R2_ACCESS_KEY_ID=twoj_r2_access_key_id
R2_SECRET_ACCESS_KEY=twoj_r2_secret_access_key
R2_BUCKET=revvo-media
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
NEXT_PUBLIC_MEDIA_URL=https://<TWOJA_DOMENA_R2>.r2.dev

# ── Upload ───────────────────────────────────────────────────
UPLOAD_MAX_MB=15
UPLOAD_URL_TTL=300

# ── Cloudflare Turnstile (anty-spam przy rejestracji) — opcjonalne ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=twoj_turnstile_site_key
TURNSTILE_SECRET_KEY=twoj_turnstile_secret_key

# ── E-mail (weryfikacja konta, reset hasła) — opcjonalne ─────
# Np. Resend: https://resend.com
RESEND_API_KEY=twoj_resend_api_key
EMAIL_FROM="REVVO <kontakt@twojadomena.pl>"
