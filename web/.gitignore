# ==============================================================================
# REVVO Web — .gitignore
# ==============================================================================

# --- Prywatne dane, sekrety i środowisko -------------------------------------
.env
.env*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Testy i raporty testowe -------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
.pytest_cache/
.coverage
htmlcov/
cypress/videos/
cypress/screenshots/
test/
tests/
__tests__/
*.test.*
*.spec.*

# --- Zależności ---------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js & Build ----------------------------------------------------------
/.next/
/out/
/build
dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# --- Logi i pliki tymczasowe --------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp
*.bak

# --- System operacyjny i edytory ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Asystenci AI (Claude, Agents) --------------------------------------------
.claude/
.claude*
CLAUDE.md
AGENTS.md
